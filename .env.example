# Primary conversation + event-analysis model (Groq, OpenAI-compatible, ~300 ms)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Fallback chain on the Gemini API, comma-separated
GEMINI_API_KEY=
GEMMA_MODELS=gemma-4-26b-a4b-it,gemini-3.8-flash
GEMMA_TIMEOUT_MS=6000

# ElevenLabs Conversational Agent
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Header ElevenLabs must send to /v1/chat/completions (any random string)
CUSTOM_LLM_SECRET=

# Project the coding agent edits, and its dev server for the embedded preview
PROJECT_DIR=/absolute/path/to/demo-project
PREVIEW_URL=http://localhost:5174

# Optional
# PROVIDER=fake          # UI development without Codex
# CODEX_MODEL=           # override Codex model
# PORT=3000
